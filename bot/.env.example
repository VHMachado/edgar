# Copy to /opt/edgar-bot/.env and fill in. Never commit the real file.
# chmod 600 it — it holds the HTTP shared secret.
# The shell scripts in scripts/ source this same file.

# Shared secret for POST /send. Generate one:
#   openssl rand -hex 32
EDGAR_TOKEN=

# Comma-separated phone numbers allowed to command the bot.
# International format, no "+", no spaces. Everyone else is ignored.
EDGAR_ALLOWLIST=15551234567

# Where scripts (heartbeat, alerts, backup) send their messages.
# Defaults to the first entry of EDGAR_ALLOWLIST.
EDGAR_DEFAULT_TO=15551234567

# HTTP send API
EDGAR_HTTP_HOST=127.0.0.1
EDGAR_HTTP_PORT=18790

# Optional extra bind address so other machines can POST /send.
# Use a Tailscale/VPN IP — never a public one, the API is token-only.
#EDGAR_HTTP_EXTRA_HOST=100.x.y.z

# Paths
EDGAR_CREDS_DIR=/opt/edgar-bot/creds
EDGAR_STATE_FILE=/opt/edgar-bot/state.json
NAS_MONITOR_DIR=/opt/nas-monitor

# Named jobs for the "run <name>" command, as JSON.
# Single-quote the value — both systemd and bash keep the inner quotes that way.
#EDGAR_JOBS='{"photos":"/home/me/.venv/bin/python /home/me/organize-photos.py"}'
EDGAR_JOBS='{}'
