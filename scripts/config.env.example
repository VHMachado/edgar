# Copy to config.env next to the scripts and fill in. Never commit the real file.
# chmod 600 it — it holds API keys.

# Where these scripts live. Logs and state go under it.
BASE_DIR=/opt/nas-monitor

# Which checks monitor.sh runs. Drop the ones you do not have.
# The order here is the order they appear in `status` and in the heartbeat:
# network first, then the DNS chain, then storage, then Docker stacks.
CHECKS="tailscale pihole unbound syncthing samba vaultwarden immich"

# Seconds to wait on any single service check before calling it dead.
SERVICE_TIMEOUT=10

# Days to keep monitor/cron/alert JSON before cleanup.sh removes it.
LOG_RETENTION_DAYS=30

# --- Syncthing ---
SYNCTHING_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=
# systemd unit name — usually syncthing@<your-user>.service
SYNCTHING_SERVICE=syncthing@youruser.service

# --- Pi-hole (v6 API) ---
PIHOLE_URL=http://localhost
PIHOLE_PASSWORD=

# --- Unbound (recursive resolver Pi-hole forwards to) ---
UNBOUND_PORT=5335

# --- qBittorrent (download progress and finished-download alerts) ---
# Leave as is when qBittorrent runs in Docker with its port published and the
# bridge subnet in its AuthSubnetWhitelist — then the host needs no credentials.
# Otherwise put them in the URL: http://user:pass@127.0.0.1:8080
QB_URL=http://127.0.0.1:8080

# --- Immich (photo library) ---
# Directory holding docker-compose.yml. A docker-compose.override.yml next to
# it is picked up too, which is where a profile-disabled machine-learning
# service belongs on a CPU below x86-64-v2.
IMMICH_DIR=/opt/immich
IMMICH_URL=http://127.0.0.1:2283

# --- Vaultwarden ---
VAULTWARDEN_URL=https://localhost:8443
# CA cert for a self-signed Vaultwarden. Leave empty to skip verification.
VAULTWARDEN_CA_CERT=

# --- Bitwarden CLI (drives the vault commands) ---
BW_BIN=bw
# File holding the vault master password, chmod 600. Read at every call.
BW_MASTER_PWD_FILE=/home/youruser/.vw_master
