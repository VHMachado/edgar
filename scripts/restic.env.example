# Copy to restic.env next to the scripts. Never commit the real file.
# chmod 600 it.

# Repository encryption password.
# KEEP AN OFFLINE COPY — without it the backups cannot be restored, ever.
RESTIC_PASSWORD=

# Backblaze B2 application key with access to the bucket below.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
B2_BUCKET=

# Space-separated paths to back up.
BACKUP_PATHS="/storage /home/youruser/vaultwarden/data"
